{
  "version": 6,
  "configurePresets": [
    {
      "name": "clang-base",
      "hidden": true,
      "description": "Base configuration for Clang with Ninja",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      }
    },
    {
      "name": "clang-debug",
      "displayName": "Clang Debug (Sanitizers + Tests)",
      "description": "Debug build with ASan, UBSan, warnings as errors, and tests enabled",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "ENABLE_SANITIZERS": "ON",
        "ENABLE_WARNINGS_AS_ERRORS": "ON",
        "BUILD_DOCS": "ON" 
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "description": "Optimized build with no debug symbols and tests off",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF",
        "BUILD_DOCS": "OFF" 
      }
    },
    {
      "name": "clang-docs",
      "displayName": "GCC Documentation Only",
      "description": "Generate documentation without building the project",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF",
        "BUILD_DOCS": "ON" 
      }
    }
  ],

  "buildPresets": [
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "displayName": "Build Clang Debug"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release",
      "displayName": "Build Clang Release"
    },
    {
      "name": "clang-docs",
      "configurePreset": "clang-docs",
      "displayName": "Build Documentation",
      "targets": ["doc"]
    }
  ],

  "testPresets": [
    {
      "name": "clang-debug",
      "configurePreset": "clang-debug",
      "configuration": "Debug",
      "displayName": "Test Clang Debug (under Sanitizers)"
    }
  ]
}

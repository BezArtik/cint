{
  "version": 6,
  "configurePresets": [
    {
      "name": "gcc-base",
      "hidden": true,
      "description": "Base configuration for MinGW GCC",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "BUILD_SAMPLES": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "environment": {
        "CC": "gcc",
        "CXX": "g++"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug",
      "description": "GCC build with debug symbols (-g)",
      "inherits": "gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "description": "GCC build with optimizations (-O3)",
      "inherits": "gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "gcc-debug-sanitized",
      "displayName": "GCC Debug + Sanitizers",
      "description": "GCC Debug with ASan and UBSan enabled",
      "inherits": "gcc-debug",
      "cacheVariables": {
        "ENABLE_SANITIZERS": "ON",
        "ENABLE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "gcc-release-profiling",
      "displayName": "GCC Release + Profiling (gperftools)",
      "description": "Optimized build with debug symbols and frame pointer for CPU profiling with gperftools",
      "inherits": "gcc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fno-omit-frame-pointer",
        "BUILD_TESTS": "OFF",
        "BUILD_SAMPLES": "ON"
      }
    },
    {
      "name": "gcc-debug-callgrind",
      "displayName": "GCC Debug + Callgrind",
      "description": "Debug build optimized for Valgrind/Callgrind accurate instruction counting and memory profiling",
      "inherits": "gcc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O1 -fno-inline-functions -fno-omit-frame-pointer",
        "BUILD_TESTS": "OFF"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "displayName": "Build GCC Debug"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "displayName": "Build GCC Release"
    },
    {
      "name": "gcc-debug-sanitized",
      "configurePreset": "gcc-debug-sanitized",
      "displayName": "Build GCC Debug + Sanitizers"
    },
    {
      "name": "gcc-release-profiling",
      "configurePreset": "gcc-release-profiling",
      "displayName": "Build GCC Release + Profiling"
    },
    {
      "name": "gcc-debug-callgrind",
      "configurePreset": "gcc-debug-callgrind",
      "displayName": "Build GCC Debug + Callgrind"
    }
  ],

  "testPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "configuration": "Debug",
      "displayName": "Test GCC Debug"
    },
    {
      "name": "gcc-debug-sanitized",
      "configurePreset": "gcc-debug-sanitized",
      "configuration": "Debug",
      "displayName": "Test GCC Debug + Sanitizers"
    }
  ]
}

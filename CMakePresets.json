{
  "version": 6,
  "configurePresets": [
    {
      "name": "gcc-base",
      "hidden": true,
      "description": "Base configuration for GCC with Ninja",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "environment": {
        "CC": "gcc",
        "CXX": "g++"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug (Sanitizers + Tests)",
      "description": "Debug build with ASan, UBSan, warnings as errors, and tests enabled",
      "inherits": "gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "ENABLE_SANITIZERS": "ON",
        "ENABLE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release",
      "description": "Optimized build with no debug symbols and tests off",
      "inherits": "gcc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "displayName": "Build GCC Debug"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release",
      "displayName": "Build GCC Release"
    }
  ],

  "testPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug",
      "configuration": "Debug",
      "displayName": "Test GCC Debug (under Sanitizers)"
    }
  ]
}
